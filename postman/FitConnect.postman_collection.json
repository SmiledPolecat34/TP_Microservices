{
  "info": {"name": "FitConnect - Parcours complet", "description": "À exécuter dans l'ordre (Collection Runner). Toutes les requêtes passent par l'API Gateway. Les identifiants sont enregistrés dans les variables de collection.", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key":"baseUrl","value":"http://localhost:8080"},{"key":"classId","value":"1"},{"key":"bookingId","value":"1"},{"key":"smallClassId","value":"1"},{"key":"soonClassId","value":"1"},{"key":"soonBookingId","value":"1"},{"key":"soonDateTime","value":""},{"key":"expiredBookingId","value":"1"}],
  "item": [
    {"name":"1. Gestion des cours","item":[
      {"name":"Créer un cours","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"Yoga Flow\",\n  \"description\": \"Cours de yoga tous niveaux\",\n  \"instructor\": \"Marie\",\n  \"gymLocation\": \"Paris\",\n  \"category\": \"YOGA\",\n  \"level\": \"INTERMEDIATE\",\n  \"durationMinutes\": 60,\n  \"maxParticipants\": 10,\n  \"price\": 20.00,\n  \"dateTime\": \"2030-10-10T18:00:00\"\n}"},"url":"{{baseUrl}}/api/classes"},"event":[{"listen":"test","script":{"exec":["pm.test('201 Created',()=>pm.response.to.have.status(201));","pm.test('cours SCHEDULED sans participant',()=>{pm.expect(pm.response.json().status).to.eql('SCHEDULED');pm.expect(pm.response.json().currentParticipants).to.eql(0);});","pm.collectionVariables.set('classId',pm.response.json().id);"]}}]},
      {"name":"Créer un cours invalide (400)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"ab\",\n  \"description\": \"Nom trop court, durée et prix invalides\",\n  \"instructor\": \"Marie\",\n  \"gymLocation\": \"Paris\",\n  \"category\": \"YOGA\",\n  \"level\": \"BEGINNER\",\n  \"durationMinutes\": 50,\n  \"maxParticipants\": 3,\n  \"price\": 1.00,\n  \"dateTime\": \"2030-10-10T18:00:00\"\n}"},"url":"{{baseUrl}}/api/classes"},"event":[{"listen":"test","script":{"exec":["pm.test('400 Bad Request',()=>pm.response.to.have.status(400));"]}}]},
      {"name":"Lister les cours","request":{"method":"GET","url":"{{baseUrl}}/api/classes?page=0&size=10&sort=dateTime,asc"},"event":[{"listen":"test","script":{"exec":["pm.test('200 + page',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().content).to.be.an('array');});"]}}]},
      {"name":"Filtrer les cours","request":{"method":"GET","url":"{{baseUrl}}/api/classes?category=YOGA&level=INTERMEDIATE&dateFrom=2030-10-01&dateTo=2030-10-20&location=Paris&instructor=Marie"},"event":[{"listen":"test","script":{"exec":["pm.test('uniquement YOGA / INTERMEDIATE',()=>pm.response.json().content.forEach(c=>{pm.expect(c.category).to.eql('YOGA');pm.expect(c.level).to.eql('INTERMEDIATE');}));"]}}]},
      {"name":"Rechercher des cours","request":{"method":"GET","url":"{{baseUrl}}/api/classes/search?category=YOGA&location=Paris"},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));"]}}]},
      {"name":"Détails d'un cours","request":{"method":"GET","url":"{{baseUrl}}/api/classes/{{classId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));"]}}]}
    ]},
    {"name":"2. Réservation","item":[
      {"name":"Réserver deux places","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"userId\": 1,\n  \"userEmail\": \"john@example.com\",\n  \"userName\": \"John Doe\",\n  \"classId\": {{classId}},\n  \"numberOfSpots\": 2\n}"},"url":"{{baseUrl}}/api/bookings"},"event":[{"listen":"test","script":{"exec":["pm.test('201 Created',()=>pm.response.to.have.status(201));","pm.test('PENDING_PAYMENT, total = 40',()=>{pm.expect(pm.response.json().status).to.eql('PENDING_PAYMENT');pm.expect(pm.response.json().totalAmount).to.eql(40);});","pm.collectionVariables.set('bookingId',pm.response.json().id);"]}}]},
      {"name":"Vérifier status PENDING_PAYMENT","request":{"method":"GET","url":"{{baseUrl}}/api/bookings/{{bookingId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('PENDING_PAYMENT',()=>pm.expect(pm.response.json().status).to.eql('PENDING_PAYMENT'));"]}}]},
      {"name":"Vérifier les places réservées","request":{"method":"GET","url":"{{baseUrl}}/api/classes/{{classId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('2 participants',()=>pm.expect(pm.response.json().currentParticipants).to.eql(2));"]}}]},
      {"name":"Réservations de l'utilisateur","request":{"method":"GET","url":"{{baseUrl}}/api/bookings/user/1"},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));"]}}]}
    ]},
    {"name":"3. Paiement","item":[
      {"name":"Payer (carte valide)","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"cardLastFour\": \"1234\",\n  \"transactionId\": \"txn_123456\"\n}"},"url":"{{baseUrl}}/api/bookings/{{bookingId}}/confirm"},"event":[{"listen":"test","script":{"exec":["pm.test('200 + CONFIRMED',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().status).to.eql('CONFIRMED');});"]}}]},
      {"name":"Vérifier status CONFIRMED","request":{"method":"GET","url":"{{baseUrl}}/api/bookings/{{bookingId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('CONFIRMED',()=>pm.expect(pm.response.json().status).to.eql('CONFIRMED'));"]}}]},
      {"name":"Paiement de la réservation (SUCCESS)","request":{"method":"GET","url":"{{baseUrl}}/api/payments/booking/{{bookingId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('SUCCESS',()=>pm.expect(pm.response.json().status).to.eql('SUCCESS'));"]}}]},
      {"name":"Historique des notifications","request":{"method":"GET","url":"{{baseUrl}}/api/notifications/user/1"},"event":[{"listen":"test","script":{"exec":["pm.test('BOOKING_CONFIRMATION et PAYMENT_CONFIRMATION envoyées',()=>{const t=pm.response.json().map(n=>n.type);pm.expect(t).to.include('BOOKING_CONFIRMATION');pm.expect(t).to.include('PAYMENT_CONFIRMATION');});"]}}]}
    ]},
    {"name":"4. Annulation (dans les délais)","item":[
      {"name":"Annuler","request":{"method":"PATCH","url":"{{baseUrl}}/api/bookings/{{bookingId}}/cancel"},"event":[{"listen":"test","script":{"exec":["pm.test('200 + CANCELLED',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().status).to.eql('CANCELLED');});"]}}]},
      {"name":"Vérifier le remboursement","request":{"method":"GET","url":"{{baseUrl}}/api/payments/booking/{{bookingId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('REFUNDED',()=>pm.expect(pm.response.json().status).to.eql('REFUNDED'));"]}}]},
      {"name":"Vérifier les places libérées","request":{"method":"GET","url":"{{baseUrl}}/api/classes/{{classId}}"},"event":[{"listen":"test","script":{"exec":["pm.test('0 participant',()=>pm.expect(pm.response.json().currentParticipants).to.eql(0));"]}}]},
      {"name":"Historique des paiements","request":{"method":"GET","url":"{{baseUrl}}/api/payments/user/1"},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));"]}}]}
    ]},
    {"name":"5. Scénarios d'erreur","item":[
      {"name":"Surréservation - créer un cours de 5 places","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"Boxe petit groupe\",\n  \"description\": \"Cours limité à 5 participants\",\n  \"instructor\": \"Karim\",\n  \"gymLocation\": \"Lyon\",\n  \"category\": \"BOXING\",\n  \"level\": \"ADVANCED\",\n  \"durationMinutes\": 45,\n  \"maxParticipants\": 5,\n  \"price\": 15.00,\n  \"dateTime\": \"2030-11-05T19:00:00\"\n}"},"url":"{{baseUrl}}/api/classes"},"event":[{"listen":"test","script":{"exec":["pm.test('201',()=>pm.response.to.have.status(201));","pm.collectionVariables.set('smallClassId',pm.response.json().id);"]}}]},
      {"name":"Surréservation - réserver 4 places (OK)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"userId\": 2,\n  \"userEmail\": \"jane@example.com\",\n  \"userName\": \"Jane Doe\",\n  \"classId\": {{smallClassId}},\n  \"numberOfSpots\": 4\n}"},"url":"{{baseUrl}}/api/bookings"},"event":[{"listen":"test","script":{"exec":["pm.test('201',()=>pm.response.to.have.status(201));"]}}]},
      {"name":"Surréservation - 2 places de plus (409)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"userId\": 3,\n  \"userEmail\": \"bob@example.com\",\n  \"userName\": \"Bob Martin\",\n  \"classId\": {{smallClassId}},\n  \"numberOfSpots\": 2\n}"},"url":"{{baseUrl}}/api/bookings"},"event":[{"listen":"test","script":{"exec":["pm.test('409 Conflict',()=>pm.response.to.have.status(409));","pm.test('message explicite',()=>pm.expect(pm.response.json().message).to.include('Plus de places disponibles'));"]}}]},
      {"name":"Paiement refusé - montant >= 100 € (4 x 60 €)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"Crossfit Premium\",\n  \"description\": \"Cours à 60 € pour dépasser le plafond de paiement\",\n  \"instructor\": \"Léa\",\n  \"gymLocation\": \"Paris\",\n  \"category\": \"CROSSFIT\",\n  \"level\": \"ADVANCED\",\n  \"durationMinutes\": 90,\n  \"maxParticipants\": 10,\n  \"price\": 60.00,\n  \"dateTime\": \"2030-11-06T19:00:00\"\n}"},"url":"{{baseUrl}}/api/classes"},"event":[{"listen":"test","script":{"exec":["const id=pm.response.json().id;","pm.sendRequest({url:pm.collectionVariables.get('baseUrl')+'/api/bookings',method:'POST',header:{'Content-Type':'application/json'},body:{mode:'raw',raw:JSON.stringify({userId:4,userEmail:'rich@example.com',userName:'Rich Client',classId:id,numberOfSpots:2})}},(e,r)=>{","  pm.sendRequest({url:pm.collectionVariables.get('baseUrl')+'/api/bookings/'+r.json().id+'/confirm',method:'PATCH',header:{'Content-Type':'application/json'},body:{mode:'raw',raw:JSON.stringify({paymentMethod:'PAYPAL',transactionId:'txn_refuse'})}},(e2,r2)=>{","    pm.test('paiement de 120 € refusé -> réservation CANCELLED',()=>pm.expect(r2.json().status).to.eql('CANCELLED'));","  });","});"]}}]},
      {"name":"Confirmer une réservation déjà annulée (409)","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"cardLastFour\": \"1234\",\n  \"transactionId\": \"txn_trop_tard\"\n}"},"url":"{{baseUrl}}/api/bookings/{{bookingId}}/confirm"},"event":[{"listen":"test","script":{"exec":["pm.test('409 Conflict',()=>pm.response.to.have.status(409));"]}}]},
      {"name":"Paiement expiré (409)","request":{"description":"Le délai de paiement est d'une heure. Pour le démontrer sans attendre, démarrer booking-service avec --booking.payment-deadline-minutes=0 (voir README), créer une réservation, renseigner son id dans la variable expiredBookingId puis lancer cette requête : 409 « Le délai de paiement est expiré ». GET /api/bookings/expired liste alors la réservation et le scheduler l'annule au passage suivant.","method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"cardLastFour\": \"1234\",\n  \"transactionId\": \"txn_expire\"\n}"},"url":"{{baseUrl}}/api/bookings/{{expiredBookingId}}/confirm"},"event":[{"listen":"prerequest","script":{"exec":["// Cible une réservation réellement expirée (PENDING_PAYMENT, échéance dépassée) s'il en existe une.","pm.sendRequest(pm.collectionVariables.get('baseUrl')+'/api/bookings/expired',(e,r)=>{","  const list=e?[]:r.json();","  pm.collectionVariables.set('hasExpiredBooking',list.length>0?'yes':'no');","  if(list.length>0)pm.collectionVariables.set('expiredBookingId',list[0].id);","});"]}},{"listen":"test","script":{"exec":["if(pm.collectionVariables.get('hasExpiredBooking')==='yes'){","  pm.test('409 Conflict',()=>pm.response.to.have.status(409));","  pm.test('refus pour cause d\\'expiration',()=>pm.expect(pm.response.json().message).to.include('délai de paiement est expiré'));","}else{","  pm.test.skip('Aucune réservation expirée : relancer booking-service avec --booking.payment-deadline-minutes=0 (voir README)');","}"]}}]},
      {"name":"Réservations en attente expirées","request":{"method":"GET","url":"{{baseUrl}}/api/bookings/expired"},"event":[{"listen":"test","script":{"exec":["pm.test('200',()=>pm.response.to.have.status(200));"]}}]},
      {"name":"Annulation hors délais - créer un cours dans 2 h","event":[{"listen":"prerequest","script":{"exec":["const d=new Date(Date.now()+2*3600*1000);","const p=n=>String(n).padStart(2,'0');","pm.collectionVariables.set('soonDateTime',`${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}:00`);"]}},{"listen":"test","script":{"exec":["pm.test('201',()=>pm.response.to.have.status(201));","pm.collectionVariables.set('soonClassId',pm.response.json().id);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"Zumba du soir\",\n  \"description\": \"Cours qui commence dans moins de 24 h\",\n  \"instructor\": \"Sofia\",\n  \"gymLocation\": \"Paris\",\n  \"category\": \"ZUMBA\",\n  \"level\": \"BEGINNER\",\n  \"durationMinutes\": 60,\n  \"maxParticipants\": 20,\n  \"price\": 10.00,\n  \"dateTime\": \"{{soonDateTime}}\"\n}"},"url":"{{baseUrl}}/api/classes"}},
      {"name":"Annulation hors délais - réserver","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"userId\": 1,\n  \"userEmail\": \"john@example.com\",\n  \"userName\": \"John Doe\",\n  \"classId\": {{soonClassId}},\n  \"numberOfSpots\": 1\n}"},"url":"{{baseUrl}}/api/bookings"},"event":[{"listen":"test","script":{"exec":["pm.test('201',()=>pm.response.to.have.status(201));","pm.collectionVariables.set('soonBookingId',pm.response.json().id);"]}}]},
      {"name":"Annulation hors délais (409)","request":{"method":"PATCH","url":"{{baseUrl}}/api/bookings/{{soonBookingId}}/cancel"},"event":[{"listen":"test","script":{"exec":["pm.test('409 Conflict',()=>pm.response.to.have.status(409));","pm.test('message explicite',()=>pm.expect(pm.response.json().message).to.include('délai d\\'annulation'));"]}}]},
      {"name":"Cours inexistant (404)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"userId\": 1,\n  \"userEmail\": \"john@example.com\",\n  \"userName\": \"John Doe\",\n  \"classId\": 999999,\n  \"numberOfSpots\": 1\n}"},"url":"{{baseUrl}}/api/bookings"},"event":[{"listen":"test","script":{"exec":["pm.test('404 Not Found',()=>pm.response.to.have.status(404));"]}}]}
    ]}
  ]
}
